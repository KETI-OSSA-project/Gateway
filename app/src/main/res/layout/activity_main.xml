<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="MQTT Gateway 설정"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <!-- 외부 브로커 설정 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="외부 브로커 URL"
            android:textStyle="bold"
            android:layout_marginBottom="10dp" /> <!-- 아래랑 간격-->

        <EditText
            android:id="@+id/editBrokerUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="예: tcp://192.168.0.6:1883"
            android:inputType="textUri"
            android:layout_marginBottom="20dp" />

        <!-- Uplink 패턴 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Uplink 토픽 패턴 (내부→외부)"
            android:textStyle="bold"
            android:layout_marginBottom="10dp" />

        <EditText
            android:id="@+id/editUplinkPattern"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="예: uplink/app/+/out"
            android:layout_marginBottom="20dp" />

        <!-- Downlink 패턴 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Downlink 토픽 패턴 (외부→내부)"
            android:textStyle="bold"
            android:layout_marginBottom="10dp" />

        <EditText
            android:id="@+id/editDownlinkPattern"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="예: downlink/app/+/in"
            android:layout_marginBottom="50dp" />

        <!-- 버튼들 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/btnStart"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="시작" />

            <Button
                android:id="@+id/btnStop"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="정지" />

        </LinearLayout>

        <!-- 상태 표시 -->
        <TextView
            android:id="@+id/textStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="대기 중..."
            android:textSize="16sp"
            android:gravity="center"
            android:layout_marginTop="18dp"
            android:padding="16dp"
            android:background="#f0f0f0" />

    </LinearLayout>
</ScrollView>
